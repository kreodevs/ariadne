{
  "name": "@kreodevs/ariadne",
  "version": "1.4.0",
  "description": "Ariadne Codebase Intelligence MCP Server & CLI",
  "author": "Jorge Correa <jcorrea@e-personal.net>",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kreodevs/ariadne.git",
    "directory": "services/mcp-ariadne"
  },
  "bin": {
    "ariadne-mcp": "./dist/index.js",
    "ariadne-daemon": "./dist/live-watcher.js",
    "ariadne-link": "./dist/cli.js",
    "ariadne": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node scripts/bundle-link.mjs",
    "sync:link": "node scripts/bundle-link.mjs --out ../../scripts/link.mjs",
    "check:link": "node scripts/bundle-link.mjs --out ../../scripts/link.mjs --check",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "daemon": "node dist/live-watcher.js",
    "test": "node --experimental-strip-types --no-warnings --test src/*.spec.ts",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ariadne-common": "file:../../packages/ariadne-common",
    "falkordb": "^6.0.0",
    "ioredis": "^5.4.2",
    "pino": "^9.14.0"
  },
  "bundledDependencies": [
    "ariadne-common"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "0.28.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "falkordb",
    "ariadne",
    "cursor"
  ]
}
